# ------------------------------------------------------------------
# Django
# ------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-cambia-esto-en-produccion
DJANGO_DEBUG=True

# En desarrollo local puedes dejar *; en producción pon tu(s) dominio(s) real(es)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Solo necesario en producción, detrás de HTTPS con dominio propio
CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------------
# Déjalo VACÍO o quítalo para usar SQLite (recomendado mientras desarrollas).
# Ponlo en "postgresql" SOLO si ya tienes Postgres instalado, corriendo,
# y la base de datos y el usuario ya creados.
DB_ENGINE=
DB_NAME=zapatillas_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------
# CORS / Frontend
# ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# Google Maps — dirección exacta en el checkout
# ------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------
# Datos de la empresa (facturación / SRI Ecuador)
# ------------------------------------------------------------------
EMPRESA_RUC=
EMPRESA_RAZON_SOCIAL=Zapatillas EC

# ------------------------------------------------------------------
# Email — TODO se envía vía Resend (https://resend.com), sin SMTP
# ------------------------------------------------------------------
DEFAULT_FROM_EMAIL=no-responder@zapatillas.ec
RESEND_API_KEY=

# ------------------------------------------------------------------
# Channels / WebSocket del chat en producción
# ------------------------------------------------------------------
CHANNEL_LAYER_BACKEND=channels.layers.InMemoryChannelLayer
REDIS_URL=redis://localhost:6379/0
